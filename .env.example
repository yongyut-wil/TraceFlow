# ── TraceFlow env vars ──────────────────────────────────────────────
# Referenced by .devin/mcp_config.json (Supabase MCP server).
# Each developer sets these on their OWN machine — never commit real values.
#
# Alternative: skip env vars entirely and put values directly in
# .devin/mcp_config.local.json (gitignored). Recommended — works for
# GUI apps too, no shell restart needed.

SUPABASE_PROJECT_REF=<your-project-ref>
SUPABASE_ACCESS_TOKEN=<your-personal-access-token>
# Get token at: https://supabase.com/dashboard/account/tokens
# Get project ref from dashboard URL: /dashboard/project/<ref>

# ── Windows ─────────────────────────────────────────────────────────
#   setx SUPABASE_ACCESS_TOKEN "<token>"
#   setx SUPABASE_PROJECT_REF "<ref>"
#   → then RESTART Devin/terminal (setx does not affect running processes)

# ── macOS / Linux ───────────────────────────────────────────────────
# Current shell only:
#   export SUPABASE_ACCESS_TOKEN="<token>"
#   export SUPABASE_PROJECT_REF="<ref>"
#
# Persistent (zsh is macOS default):
#   echo 'export SUPABASE_ACCESS_TOKEN="<token>"' >> ~/.zshrc
#   echo 'export SUPABASE_PROJECT_REF="<ref>"' >> ~/.zshrc
#   source ~/.zshrc
#   (bash users: use ~/.bash_profile instead)
#
# GUI apps (Devin launched from Dock/Finder) do NOT inherit .zshrc —
# either run:  launchctl setenv SUPABASE_ACCESS_TOKEN "<token>"
# or just use .devin/mcp_config.local.json (simplest, recommended)
